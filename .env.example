# Frontend build/runtime
NEXT_PUBLIC_SITE_URL=https://thefamilyweather.com
PUBLIC_ORIGIN=https://thefamilyweather.com
FAMILY_WEATHER_API_ORIGIN=http://127.0.0.1:3000

# Firebase's browser API key is public configuration, not a server credential.
# Restrict it in Google Cloud to the required Firebase APIs and approved domains.
NEXT_PUBLIC_FIREBASE_API_KEY=replace-with-firebase-web-api-key
FIREBASE_WEB_API_KEY=replace-with-firebase-web-api-key

# The Express backend has its own /home/mayne/apps/family-weather-api/.env.
# Its existing DATABASE_URL and Firebase verification configuration must remain set.
