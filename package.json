{
  "name": "family-weather",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "node --test backend/*.test.js && npm run test:decision",
    "test:decision": "node --experimental-strip-types --test app/lib/decisionSpine.test.ts app/lib/beachForecast.test.ts app/lib/plannerForecast.test.ts",
    "mobile:sync": "cap sync",
    "mobile:build": "vite build --config mobile/vite.config.mts && cap sync",
    "mobile:dev": "vite --config mobile/vite.config.mts",
    "mobile:ios": "cap open ios",
    "mobile:android": "cap open android",
    "mobile:run:ios": "cap run ios",
    "mobile:run:android": "cap run android"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.2",
    "@capacitor/browser": "^8.0.5",
    "@capacitor/core": "^8.6.0",
    "@capacitor/geolocation": "^8.2.4",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/push-notifications": "^8.1.3",
    "next": "16.3.3",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "devDependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/cli": "^8.6.0",
    "@capacitor/ios": "^8.6.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "express": "5.3.0",
    "pg-mem": "3.0.14",
    "supertest": "7.3.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite": "^8.3.5"
  }
}
